# Environment Configuration for Multi-Agent Autonomous Software Engineering System

# LLM Providers
# Google Gemini API Key (Required for live Gemini model execution in Google ADK and CrewAI)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API Key (Optional fallback for CrewAI if desired)
OPENAI_API_KEY=

# Execution Settings
# Mode: "live" (calls live Gemini APIs) or "deterministic_simulation" (offline reproducible evaluation mode)
EXECUTION_MODE=deterministic_simulation
DEFAULT_MODEL=gemini-2.0-flash
TEMPERATURE=0.2

# System Directories
SANDBOX_ROOT=./sandbox_workspace
BLACKBOARD_PERSIST_PATH=./sandbox_workspace/blackboard_state.json

# HITL (Human-In-The-Loop) Gatekeeper
REQUIRE_HUMAN_APPROVAL=true
AUTO_APPROVE_IN_TESTS=false

# Security & Guardrails
MAX_TOOL_TIMEOUT_SECONDS=30
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_AST_SECURITY_SCAN=true
RESTRICT_FILE_OPERATIONS_TO_SANDBOX=true

# Observability
LOG_LEVEL=INFO
ENABLE_PROVENANCE_LOGGING=true

